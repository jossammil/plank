  plank(mtcars, where = "mpg > 25 OR cyl = 8", font = "sans")
  plank(mtcars, sort = c("cyl", "-mpg"), counts = "cyl",
         views = list("Heavy" = plank_view(where = "wt > 4", sort = "-wt")))
